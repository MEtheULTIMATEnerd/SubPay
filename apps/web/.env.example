# Copy to apps/web/.env.local and fill in. Never commit the real file.
#
# Leave the Supabase values empty to run in demo mode: the app works entirely
# in the browser with a simulated sign-in and seeded demo data.
#
# Everything here is PUBLIC: NEXT_PUBLIC_* values are shipped to the browser.
# Never put the Supabase service-role key (or any other secret) in this file.

# Supabase project URL, e.g. https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase public (anon / publishable) key
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Base URL of the FastAPI service (services/api)
NEXT_PUBLIC_API_URL=http://localhost:8000
