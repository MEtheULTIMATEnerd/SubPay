# Copy to services/ai/.env and fill in. Never commit the real .env.
# This file is for the AI service (services/ai) only.

# Vision provider selection: "mock" (default, no external calls), "openrouter", or "openai"
# Use "mock" for development and automated tests.
# Use "openrouter" or "openai" only for controlled testing with valid API keys.
AI_VISION_PROVIDER=mock

# OpenRouter API key — required only when AI_VISION_PROVIDER=openrouter
# Obtain from https://openrouter.ai/keys
# Leave blank for mock provider (default).
AI_OPENROUTER_API_KEY=

# OpenRouter base URL — typically does not need to change
AI_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# OpenRouter model identifier — change to select a different vision-capable model
# The default (openai/gpt-4o-mini) requires paid credits.
# For free-tier testing, choose a free vision-capable model from OpenRouter's catalog.
AI_OPENROUTER_MODEL=openai/gpt-4o-mini

# OpenAI API key — required only when AI_VISION_PROVIDER=openai
# Obtain from https://platform.openai.com/api-keys
# Leave blank for mock provider (default).
AI_OPENAI_API_KEY=

# OpenAI base URL — typically does not need to change
AI_OPENAI_BASE_URL=https://api.openai.com/v1

# OpenAI model identifier — change to select a different vision-capable model
# The default (gpt-4o-mini) requires paid credits.
AI_OPENAI_MODEL=gpt-4o-mini

# Request timeout in seconds for vision analysis calls
AI_VISION_TIMEOUT_SECONDS=30.0
