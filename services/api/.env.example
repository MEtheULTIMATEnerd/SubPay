# Copy to services/api/.env and fill in. Never commit the real .env.
# Values come from the Supabase dashboard: Project Settings > API (and > JWT Keys).

# development | test | production
ENVIRONMENT=development

# Supabase project URL, e.g. https://abcdefghijkl.supabase.co
SUPABASE_URL=

# Public (anon / publishable) key. Sent with the caller's JWT so RLS applies.
SUPABASE_ANON_KEY=

# Server-only key that bypasses RLS. Never put this in apps/web.
SUPABASE_SERVICE_ROLE_KEY=

# Only for projects that still sign JWTs with the legacy shared secret (HS256).
# Leave empty when the project uses JWT signing keys (ES256 / RS256).
SUPABASE_JWT_SECRET=

# Comma-separated list of web origins allowed to call this API.
CORS_ORIGINS=http://localhost:3000

# Base URL of the AI service (services/ai).
AI_SERVICE_URL=http://localhost:8001

# mock: built-in deterministic contract extraction, no AI service needed.
# http: call the AI service at AI_SERVICE_URL.
AI_EXTRACTION_PROVIDER=mock
